      #set $ecl_type = str($almanac.next_eclipse_type)
      #set $ecl_type_t = {'penumbral': $gettext('penumbral'), 'partial': $gettext('partial'), 'total': $gettext('total'), 'annular': $gettext('annular')}.get($ecl_type, $ecl_type)
      #set $ecl_d = $ecl_type_t + ' &middot; ' + $ecl_d
      #except
      #pass
      #end try
      #end if
      #end if
      #except
      #pass
      #end try
      #set $sun_attr = '' if $sun_k else ' hidden'
      #set $shower_attr = '' if $shower_label else ' hidden'
      #set $dark_attr = '' if $dark_k else ' hidden'
      <div class="countdown mono" id="countdown">
        <div class="count" id="chip-pass"$pass_data$pass_attr><span class="k" id="chip-pass-k">$pass_k</span><span class="v" id="chip-pass-v">$pass_v</span><span class="d" id="chip-pass-d">$pass_d</span></div>
        <div class="count" id="chip-sun"$sun_data$sun_attr><span class="k" id="chip-sun-k">$sun_k</span><span class="v" id="chip-sun-v">$sun_v</span><span class="d" id="chip-sun-d">$sun_d</span></div>
        <div class="count" id="chip-shower" data-shower-label="$shower_label"$shower_data$shower_attr><span class="k" id="chip-shower-k">$shower_label</span><span class="v" id="chip-shower-v">$shower_v</span><span class="d" id="chip-shower-d">$shower_note</span></div>
        <div class="count" id="chip-dark"$dark_data$dark_attr><span class="k" id="chip-dark-k">$dark_k</span><span class="v" id="chip-dark-v">$dark_v</span><span class="d" id="chip-dark-d">$dark_d</span></div>
        <div class="count" id="chip-season"$season_data$season_attr><span class="k" id="chip-season-k">$season_k</span><span class="v" id="chip-season-v">$season_v</span><span class="d" id="chip-season-d">$season_d</span></div>
        <div class="count" id="chip-apsis"$apsis_data$apsis_attr><span class="k" id="chip-apsis-k">$apsis_k</span><span class="v" id="chip-apsis-v">$apsis_v</span><span class="d" id="chip-apsis-d">$apsis_d</span></div>
        <div class="count" id="chip-super"$super_data$super_attr><span class="k" id="chip-super-k">$gettext('supermoon')</span><span class="v" id="chip-super-v">$super_v</span><span class="d" id="chip-super-d">$super_d</span></div>
        <div class="count" id="chip-eclipse"$ecl_data$ecl_attr><span class="k" id="chip-eclipse-k">$ecl_k</span><span class="v" id="chip-eclipse-v">$ecl_v</span><span class="d" id="chip-eclipse-d">$ecl_d</span></div>
        #for $comet_name in $comet_names
        #set $cp_k = ''
        #set $cp_v = ''
        #set $cp_d = ''
        #set $cp_data = ''
        #set $cp_attr = ' hidden'
        #try
        #set $cp_obj = getattr($almanac, $comet_name)
        #set $cp_ts = $cp_obj.perihelion.raw
        #if $cp_ts is not None
        #set $cp_data = ' data-ts="%d"' % int($cp_ts)
        #set $cp_rem = int($cp_ts - $almanac.time_ts)
        #if $cp_rem >= 0 and $cp_rem <= 30 * 86400
        #set $cp_attr = ''
        #set $cp_k = $gettext('{name} perihelion').format(name=str($cp_obj.label))
        #set $cp_hms = '%02d:%02d:%02d' % ($cp_rem % 86400 // 3600, $cp_rem % 3600 // 60, $cp_rem % 60)
        #set $cp_v = $gettext('{d}d {h}h {m}m').format(d=$cp_rem // 86400, h=$cp_rem % 86400 // 3600, m=$cp_rem % 3600 // 60) if $cp_rem >= 86400 else $cp_hms
        #set $cp_d = time.strftime($gettext('%b %-d') + ' %H:%M', time.localtime($cp_ts))
        #end if
        #end if
        #except
        #pass
        #end try
        <div class="count" id="chip-peri-$comet_name"$cp_data$cp_attr><span class="k" id="chip-peri-${comet_name}-k">$cp_k</span><span class="v" id="chip-peri-${comet_name}-v">$cp_v</span><span class="d" id="chip-peri-${comet_name}-d">$cp_d</span></div>
        #end for
      </div>

      <section>
        <h2 class="eyebrow">$gettext("The geocentric · live")</h2>
        #if not $extras
        <p class="skyhint">$gettext("Install {skyfield} (strongly recommended, and required for Proxima Centauri) or PyEphem so the almanac can serve this panel's positions and distances.").format(skyfield='<a href="https://github.com/chaunceygardiner/weewx-skyfield">weewx-skyfield</a>')</p>
        #end if
        <div class="geo-body">
          <div>
            <svg id="dial" viewBox="0 0 660 660" role="img"
                 aria-label="$gettext('Geocentric chart: bodies placed by compass azimuth and log distance from Earth')"></svg>
            <p class="caption dialcaption">$gettext("plan view — compass bearing, east to the right · rings step ×10 in distance · solid&nbsp;=&nbsp;above the horizon, dashed&nbsp;=&nbsp;below · trails show the last hour of motion") · $gettext("Hover or tap any mark for its coordinates.")</p>
          </div>
          <div class="roster mono">
            ## Display names come from the report's [Almanac] section (the
            ## same source as $almanac.<body>.label), falling back to the
            ## capitalized tag name; Proxima Centauri uses the short
            ## [Texts] label so the row never overflows.  The value cells
            ## share their [Texts] keys with the javascript, so first
            ## paint and live updates always agree.  The configured
            ## comets join the roster between Pluto and Proxima -- the
            ## roster reads nearest-tier outward, and a comet at tens
            ## of au belongs among the planets, not past the stellar
            ## rim -- same row anatomy, the shared brass comet chip
            ## (comet tags are dynamic, so per-tag color classes cannot
            ## exist): the guarded cells leave an elementless comet's
            ## row honestly empty (MPC drops faded comets; absence,
            ## never the string "None").
            ##
            ## Read the [Almanac] names out of the almanac's __dict__, never
            ## as $almanac.texts: WeeWX only grew the texts attribute in 5.3
            ## and this extension supports 5.2.  On 5.2 the plain attribute
            ## lookup does NOT fail cleanly -- Almanac.__getattr__ walks the
            ## registered almanacs and PyEphem's catch-all hands back an
            ## AlmanacBinder for a "heavenly body" named texts, so the access
            ## succeeds, returns something truthy, and the page then dies on
            ## .get with "cannot find 'get'".  A getattr() default can never
            ## fire; __dict__ is the only lookup that tells the truth.  On
            ## 5.2 the roster falls back to capitalized English tag names.
            #set $almanac_texts = $almanac.__dict__.get('texts', {})
            #for $body_name in ($geo_bodies[:-1] + tuple($comet_names) + $geo_bodies[-1:])
            #set $chip_cls = 'chip-comet' if $body_name in $comet_names else 'chip-' + $body_name
            #set $display_name = $gettext('Proxima') if $body_name == 'proxima_centauri' else str($almanac_texts.get($body_name, $body_name.capitalize()))
            #set $dist_html = ''
            #set $au_html = ''
            #set $alt_html = ''
            #set $below_cls = ''
            #if $extras
            #try
            #set $body_obj = getattr($almanac, $body_name)
            #set $au_val = $body_obj.earth_distance
            #set $alt_val = $body_obj.alt
            #set $dist_html = "{:,.0f}".format($au_val * $per_au)
            #set $au_str = ("%.1f" % $au_val) if $au_val >= 1000 else ("%.6f" % $au_val)
            #set $au_html = $gettext('{dist} au').format(dist=$au_str)
            #set $alt_html = $gettext('below horizon') if $alt_val < 0 else $gettext('alt {alt}°').format(alt=("%.1f" % $alt_val))
            #set $below_cls = ' below' if $alt_val < 0 else ''
            #except
            #pass
            #end try
            #end if
            <div class="row$below_cls" id="geo-row-$body_name">
              <span class="bname"><span class="chip $chip_cls"></span>$display_name</span>
              <span class="odo"><span id="almanac.${body_name}.earth_distance">$dist_html</span><span class="unit">$distance_label</span></span>
              <span class="rsub"><span id="geo-rate-$body_name"></span><span id="geo-au-$body_name">$au_html</span><span id="geo-alt-$body_name">$alt_html</span></span>
            </div>
            #end for
          </div>
        </div>
      </section>

      <section>
        <h2 class="eyebrow">$gettext("The sky dome · live")</h2>
        ## The dome is weewx-skyfield's dome_svg, embedded per report cycle
        ## through the guarded $sky_page (celestial_sky.CelestialSkyPage:
        ## the real SkyPage when skyfield is installed, else None -- and
        ## dome_svg's own guard returns '' when the skyfield almanac is not
        ## actually registered, so one emptiness test covers both).  It is
        ## sky-chart orientation -- north top, EAST LEFT, agreeing with
        ## skyfield's own Sky page and deliberately opposite the dial's
        ## map-convention plan view; do not harmonize them.  The javascript
        ## refetches the dome fragment (dome-svg.txt, written by its own
        ## template each report cycle) and nudges the sun/moon/planet marks
        ## at loop rates between refreshes through their data-body hooks
        ## (skyfield 2.0's consumer contract); satellites are the genuinely
        ## live layer.
        #set $dome_html = ''
        #if $sky_page
        #try
        #set $dome_html = str($sky_page.dome_svg($almanac, palette=$palette))
        #except
        #pass
        #end try
        #end if
        #if $dome_html
        <div class="domepanel">
          <div id="dome-wrap">
            ## The inner div is the javascript's swap target: the dome
            ## fragment refetch replaces exactly this element's contents.
            ## The wrapper self-describes like the staggered fragments
            ## (dome-svg-frag.inc owns the math -- keep this block in
            ## step), so the javascript can pick the right slot from the
            ## very first refetch.
            ## SECONDS, explicitly -- see dome-svg-frag.inc: a report
            ## carrying group_interval = hour reports five minutes as
            ## 0.0833, int() makes that 0, and every fragment renders
            ## empty (Jacques Terrettaz, issue #4).
            #set $frag_interval = 300
            #try
            ## round(), not int(): the unit conversion is floating point, so an
            ## hour-based interval comes back as 299.99988 and truncation would
            ## quietly cost the set a slot.
            #set $frag_interval = int(round($current.interval.second.raw))
            #except
            #pass
            #end try
            #if not $frag_interval or $frag_interval <= 0
            #set $frag_interval = 300
            #end if
            #set $frag_step = max(60, $frag_interval // 10)
            #set $frag_count = min(10, max(1, $frag_interval // $frag_step))
            #set $frag_ts = int($almanac.time_ts)
            <div id="dome-svg"><div class="domefrag" data-dome-ts="$frag_ts" data-dome-step="$frag_step" data-dome-count="$frag_count" data-dome-interval="$frag_interval">$dome_html</div></div>
            <p class="caption dialcaption">$gettext("North at the top, east at the left — the sky-chart orientation, as if lying on your back looking up.  Altitude rings at 30° and 60°; the rim is the horizon.") $gettext("Hover or tap any mark for its coordinates.")</p>
            ## The backdrop's health line, written by the javascript
            ## (updateDomeStale) and hidden until the fragment refetches
            ## stop landing -- at which point the dome freezes rather
            ## than flying live marks over a motionless star field, and
            ## this says so, naming the fault.  ALWAYS hidden at first
            ## paint: a page carries a backdrop of its own generation
            ## instant, which is by definition current.  The link is the
            ## one place on the page that sends a reader to the manual,
            ## because this is the one condition the page cannot fix by
            ## itself.
            <p class="stalehint" id="dome-stale" hidden><span id="dome-stale-msg"></span> · <a href="https://chaunceygardiner.github.io/weewx-celestial/troubleshooting.html#the-star-field-is-frozen">$gettext("what to check")</a></p>
          </div>
          ## The satellite rosters: one row per CONFIGURED satellite --
          ## [Skyfield] [[Satellites]], enumerated through skyfield 2.0's
          ## public $sky_page.satellite_names() (guarded: an older
          ## skyfield has no method and no satellites, so no rows) -- a
          ## satellite whose tags error is simply skipped, so a lesser
          ## almanac costs rows, never the page.  Two tables, split by
          ## panel: the dome (which draws any overhead satellite, dimmed
          ## when not visible) gets the next pass of ANY kind, each row
          ## tagged visible/not visible from next_pass.visible; the Next
          ## Pass panel below gets the next VISIBLE pass, the chart's own
          ## story.  Rows first-paint here
          ## and go live from loop data; the include feeds the javascript
          ## the same list, so rows and live layer always agree.  The
          ## pass line, the honest no-pass and no-elements rows all reuse
          ## weewx-skyfield's Sky page wording, so the translations are
          ## shared verbatim; the any-pass strings are celestial's own.
          #set $sat_names = []
          #try
          #for $n in $sky_page.satellite_names()
          #silent $sat_names.append(str($n))
          #end for
          #except
          #pass
          #end try
          #set $sat_rows = []
          #for $sat_name in $sat_names
          #try
          #set $sat_obj = getattr($almanac, $sat_name)
          #set $sat_label = str($sat_obj.label)
          #set $sat_pass = $sat_obj.next_visible_pass
          #set $sat_line = ''
          #set $sat_sub = ''
          ## The head line is composed, never str($sat_pass.rise): the
          ## bare ValueHelper renders ephem_day (time-of-day only), and a
          ## next pass can be days out -- a dated line is the truthful
          ## first paint.  Same date + HM + countdown idiom as skyfield's
          ## satellite chips and this page's own live layer (fmtDayHM +
          ## satWhen), so the live replacement changes dress, not meaning.
          #if $sat_pass.rise.raw is not None
          #set $sat_delta = $sat_pass.rise.raw - $almanac.time_ts
          #if $sat_pass.set.raw is not None and $sat_pass.rise.raw <= $almanac.time_ts and $almanac.time_ts < $sat_pass.set.raw
          #set $sat_when = $gettext('overhead now')
          #else if $sat_delta < 3600
          #set $sat_when = $gettext('in {m} min').format(m=max(1, int($sat_delta // 60)))
          #else if $sat_delta < 86400
          #set $sat_when = $gettext('in {h} h').format(h=int(round($sat_delta / 3600)))
          #else
          ## Whole days is a CALENDAR-day difference, not elapsed seconds
          ## divided down: the count stands on the same line as the pass's
          ## own date, and a count reckoned any other way contradicts the
          ## date beside it twice a day -- rounding up calls a pass later
          ## this evening "in 1 day" (Jacques Terrettaz's report against
          ## weewx-skyfield's chips, the 2026-08-12 partial solar eclipse,
          ## issue #6), rounding down calls one just past midnight
          ## "today".  Differencing the two local dates is DST-correct
          ## for free; the floor at 1 is the fall-back Sunday's belt and
          ## braces, where 24 elapsed hours can land back on today.  The
          ## live layer's satWhen reckons identically.
          #set $sat_days = max(1, (datetime.date.fromtimestamp($sat_pass.rise.raw) - datetime.date.fromtimestamp($almanac.time_ts)).days)
          #set $sat_when = $gettext('in {n} day').format(n=1) if $sat_days == 1 else $gettext('in {n} days').format(n=$sat_days)
          #end if
          #set $sat_line = time.strftime($gettext('%b %-d') + ' %H:%M', time.localtime($sat_pass.rise.raw)) + ' · ' + $sat_when
          #set $sat_sub = $gettext('appears {rise} · peaks {alt}° {culm} · disappears {set} · {m} min').format(rise=str($sat_pass.rise_azimuth.ordinal_compass), alt='%.0f' % $sat_pass.max_altitude.raw, culm=str($sat_pass.culmination_azimuth.ordinal_compass), set=str($sat_pass.set_azimuth.ordinal_compass), m='%d' % round($sat_pass.duration.raw / 60))
          #else if $sat_obj.sunlit is not None
          #set $sat_line = $gettext('no visible pass in the coming week')
          #else
          #set $sat_line = $gettext('no usable orbital elements — see the weewxd log')
          #end if
          #set $any_pass = $sat_obj.next_pass
          #set $any_line = ''
          #set $any_sub = ''
          #if $any_pass.rise.raw is not None
          #set $any_delta = $any_pass.rise.raw - $almanac.time_ts
          #if $any_pass.set.raw is not None and $any_pass.rise.raw <= $almanac.time_ts and $almanac.time_ts < $any_pass.set.raw
          #set $any_when = $gettext('overhead now')
          #else if $any_delta < 3600
          #set $any_when = $gettext('in {m} min').format(m=max(1, int($any_delta // 60)))
          #else if $any_delta < 86400
          #set $any_when = $gettext('in {h} h').format(h=int(round($any_delta / 3600)))
          #else
          ## Calendar days, exactly as the visible-pass row above.
          #set $any_days = max(1, (datetime.date.fromtimestamp($any_pass.rise.raw) - datetime.date.fromtimestamp($almanac.time_ts)).days)
          #set $any_when = $gettext('in {n} day').format(n=1) if $any_days == 1 else $gettext('in {n} days').format(n=$any_days)
          #end if
          #set $any_line = time.strftime($gettext('%b %-d') + ' %H:%M', time.localtime($any_pass.rise.raw)) + ' · ' + $any_when
          #set $any_sub = $gettext('appears {rise} · peaks {alt}° {culm} · disappears {set} · {m} min').format(rise=str($any_pass.rise_azimuth.ordinal_compass), alt='%.0f' % $any_pass.max_altitude.raw, culm=str($any_pass.culmination_azimuth.ordinal_compass), set=str($any_pass.set_azimuth.ordinal_compass), m='%d' % round($any_pass.duration.raw / 60))
          #if $any_pass.visible is True
          #set $any_sub = $any_sub + ' · ' + $gettext('visible')
          #else if $any_pass.visible is False
          #set $any_sub = $any_sub + ' · ' + $gettext('not visible')
          #end if
          #else if $sat_obj.sunlit is not None
          #set $any_line = $gettext('no pass in the coming week')
          #else
          #set $any_line = $gettext('no usable orbital elements — see the weewxd log')
          #end if
          #silent $sat_rows.append((str($sat_name), $sat_label, $sat_line, $sat_sub, $any_line, $any_sub))
          #except
          #pass
          #end try
          #end for
          #if $sat_rows
          <div class="roster mono">
            <h3 class="eyebrow">$gettext("Satellites · the next pass overhead")</h3>
            #for $sat_name, $sat_label, $sat_line, $sat_sub, $any_line, $any_sub in $sat_rows
            <div class="row" id="sat-any-row-$sat_name">
              <span class="bname"><span class="chip chip-sat"></span>$sat_label</span>
              <span class="odo satline" id="sat-any-line-$sat_name">$any_line</span>
              <span class="rsub"><span id="sat-any-pass-$sat_name">$any_sub</span></span>
            </div>
            #end for
          </div>
          #end if
        </div>
        #else
        <p class="skyhint">$gettext("Install {skyfield} so the almanac can draw the live sky dome.").format(skyfield='<a href="https://github.com/chaunceygardiner/weewx-skyfield">weewx-skyfield</a>')</p>
        #end if
      </section>

      ## The Next Visible Pass panel: skyfield 2.0's pass_chart_html -- the whole
      ## sky as it will stand at the culmination of the soonest upcoming
      ## visible pass among the configured satellites, the pass's arc
      ## dashed across it under a dated head line (the dome stopped
      ## drawing the arc in 2.0: an undated future track on the now-sky
      ## crossed stars it will never cross) -- beside the visible-pass
      ## roster, the chart's own story.  The chart is empty when no
      ## configured satellite has a visible pass in its elements'
      ## validity window: the roster's honest rows then tell that story
      ## with the chart area hidden, and the whole section hides only
      ## when there are no satellite rows either.  The javascript's
      ## fragment refetch (pass-chart.txt) unhides the chart when a pass
      ## enters the window.  During an in-progress pass the chart's
      ## epoch is within minutes of now, so the javascript sweeps the
      ## featured satellite's data-body marker along the drawn arc; the
      ## chart's sun, moon, planets and stars belong to the culmination
      ## instant and are never nudged.
      #set $passchart = ''
      #if $sky_page
      #try
      #set $passchart = str($sky_page.pass_chart_html($almanac, palette=$palette))
      #except
      #pass
      #end try
      #end if
      #if $dome_html
      #set $pass_sec_attr = '' if ($passchart or $sat_rows) else ' hidden'
      #set $pass_wrap_attr = '' if $passchart else ' hidden'
      <section id="pass-sec"$pass_sec_attr>
        <h2 class="eyebrow">$gettext("The Next Visible Pass · the sky at its peak")</h2>
        <div class="passpanel">
          <div id="pass-wrap"$pass_wrap_attr>
            <div id="pass-chart">$passchart</div>
            <p class="caption passcaption">$gettext("The whole sky as it will stand at the pass's highest point, on the date above — the dashed arc is the satellite's path, its rise and set times at the ends.  Only stars bright enough for a twilight sky are drawn: a visible pass happens while your sky is half dark.")</p>
          </div>
          #if $sat_rows
          <div class="roster mono">
            <h3 class="eyebrow">$gettext("Satellites · the next visible pass")</h3>
            #for $sat_name, $sat_label, $sat_line, $sat_sub, $any_line, $any_sub in $sat_rows
            <div class="row" id="sat-row-$sat_name">
              <span class="bname"><span class="chip chip-sat"></span>$sat_label</span>
              <span class="odo satline" id="sat-line-$sat_name">$sat_line</span>
              <span class="rsub"><span id="sat-pass-$sat_name">$sat_sub</span></span>
            </div>
            #end for
          </div>
          #end if
        </div>
      </section>
      #end if

      <footer>
        ## The credit must be true for whatever almanac actually serves the
        ## page, probed by capability: Proxima Centauri needs a Skyfield
        ## almanac with a star catalog (the full credit); any other extended
        ## almanac gets the generic credit; the built-in almanac serves no
        ## live fields at all.  On top of the capability probe, an IDENTITY
        ## check -- the same class-name-plus-module match weewx-skyfield's
        ## own register_almanac uses -- decides whether the credit may name
        ## weewx-skyfield and link its manual: the independent
        ## weewx-skyfield-almanac extension also names its class
        ## SkyfieldAlmanacType and could pass the Proxima probe, and must
        ## not be credited as ours.
        #set $wxsf = any([type(a).__name__ == 'SkyfieldAlmanacType' and type(a).__module__.split('.')[-1] == 'wxskyfield' for a in getattr(weewx.almanac, 'almanacs', [])])
        #set $footer_credit = $gettext("Calculated with WeeWX's built-in almanac")
        #if $extras
        #set $footer_credit = $gettext("Calculated with the station's extended almanac (weewx-skyfield or PyEphem)")
        #try
        #silent $almanac.proxima_centauri.earth_distance
        #if $wxsf
        #set $footer_credit = $gettext("Calculated with weewx-skyfield: Skyfield, JPL's DE421 ephemeris and the Hipparcos star catalog (Credit: ESA)")
        #else
        #set $footer_credit = $gettext("Calculated with Skyfield, JPL's DE421 ephemeris and the Hipparcos star catalog (Credit: ESA)")
        #end if
        #except
        #pass
        #end try
        #end if
        ## The name becomes a project-page link only when the check above
        ## proved it is truly this extension serving the page; substituted
        ## after translation, so it survives any language that keeps the
        ## proper noun verbatim.
        #if $wxsf
        #set $footer_credit = $footer_credit.replace('weewx-skyfield', '<a href="https://github.com/chaunceygardiner/weewx-skyfield">weewx-skyfield</a>')
        #end if
        $footer_credit &middot; $gettext("live via weewx-loopdata").
      </footer>
    </div>
  </body>
</html>
